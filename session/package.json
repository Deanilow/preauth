{
  "name": "sur-auth-apponbsesser",
  "version": "1.0.0",
  "description": "Nodejs microservice example",
  "main": "./dist/server/index.js",
  "author": "",
  "system": "darwin-generator-nodejs-system",
  "subSystem": "darwin-generator-nodejs-sub-system",
  "application": "darwin-generator-nodejs-application",
  "subApplication": "subApplication",
  "appKey": "auth",
  "license": "ISC",
  "scripts": {
    "start": "node ./app/server/index.js || echo ERROR: execute 'npm run build' before start the server",
    "dev": "ts-node-dev -r tsconfig-paths/register ./src/server/index.ts",
    "build": "tsc --build tsconfig.json && tsc-alias -p tsconfig.json",
    "lint": "eslint ./**/*.ts",
    "lint:fix": "eslint ./**/*.ts --quiet --fix",
    "precommit": "npm run test:coverage",
    "audit": "npm audit --registry=https://registry.npmjs.org --proxy=http://proxyapps.gsnet.corp:80 --strict-ssl=false",
    "audit:fix": "npm audit fix --force --registry=https://registry.npmjs.org --proxy=http://proxyapps.gsnet.corp:80 --strict-ssl=false",
    "test": "cross-env NODE_ENV=test jest --detectOpenHandles --forceExit",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --coverageProvider=v8 --detectOpenHandles --forceExit --passWithNoTests",
    "test:continuous": "cross-env NODE_ENV=test jest --watchAll"
  },
  "engines": {
    "node": ">=20.*"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "axios": "1.20.0",
    "brace-expansion": "5.0.9",
    "find-my-way": "9.7.0",
    "fast-uri": "4.1.4",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "form-data": "4.0.6",
    "minimatch": "10.2.5",
    "@fastify/static": "10.1.1",
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    },
    "@typescript-eslint/eslint-plugin": {
      "js-yaml": "4.3.1"
    },
    "@fastify/swagger-ui": {
      "brace-expansion": "5.0.9",
      "@fastify/static": "10.1.1",
      "fast-uri": "4.1.4"
    },
    "@apollo/server": {
      "brace-expansion": "5.0.9",
      "form-data": "4.0.6"
    },
    "@types/node-fetch": {
      "form-data": "4.0.6"
    },
    "puppeteer-core": {
      "brace-expansion": "5.0.9"
    },
    "jsdom": {
      "brace-expansion": "5.0.9"
    },
    "eslint-config-standard-with-typescript": "^44.0.0"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.8.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "ioredis": "^5.4.1",
    "jsdom": "^29.1.1",
    "lru-cache": "^11.5.1",
    "node-fetch": "^2.7.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.5.0",
    "@types/pdfmake": "^0.3.3",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.28.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.3.4",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}